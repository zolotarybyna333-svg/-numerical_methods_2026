import numpy as np


def hooke_jeeves(func, x0, delta, eps1, eps2, q=2, p=2):

    x_base = np.array(x0, dtype=float)
    d = np.array(delta, dtype=float)
    n = len(x_base)
    trajectory = [x_base.copy()]

    def exploratory_search(x_start, current_delta, reduce_step=True):
        x_curr = x_start.copy()
        for i in range(n):
            # Крок вперед
            x_trial = x_curr.copy()
            x_trial[i] += current_delta[i]
            if func(x_trial) < func(x_curr):
                x_curr = x_trial
            else:
                # Крок назад
                x_trial = x_curr.copy()
                x_trial[i] -= current_delta[i]
                if func(x_trial) < func(x_curr):
                    x_curr = x_trial
                elif reduce_step:
                    # Зменшення кроку
                    current_delta[i] /= q
        return x_curr

    step_count = 0
    while True:
        step_count += 1
        # Етап 1: Досліджуючий пошук
        x_new = exploratory_search(x_base, d)

        # Перевірка умов закінчення
        if np.all(d < eps1) or abs(func(x_new) - func(x_base)) < eps2:
            return x_new, trajectory, step_count

        if np.array_equal(x_new, x_base):
            # Якщо точку не знайдено, алгоритм завершується
            return x_base, trajectory, step_count

        # Етап 2: Пошук по зразку
        while True:
            # Знаходимо наступну точку за напрямком
            x_pattern = x_new + p * (x_new - x_base)
            x_base = x_new.copy()
            trajectory.append(x_base.copy())

            # Досліджуючий пошук з нової точки без зменшення кроку
            x_after_expl = exploratory_search(x_pattern, d, reduce_step=False)

            if func(x_after_expl) < func(x_base):
                x_new = x_after_expl
                # Якщо краще — продовжуємо пошук по зразку
            else:
                # Якщо гірше — повертаємося до досліджуючого пошуку
                break


# --- Тестування (Пункт 3: Функція Розенброка) ---
def rosenbrock(X):
    x1, x2 = X
    return 100 * (x1 ** 2 - x2) ** 2 + (x1 - 1) ** 2  #


# Параметри
x_start = [-1.2, 0.0]
initial_delta = [0.1, 0.1]
e1 = 1e-5
e2 = 1e-5

result, path, steps = hooke_jeeves(rosenbrock, x_start, initial_delta, e1, e2)

print(f"Результат мінімізації: {result}")
print(f"Значення функції: {rosenbrock(result)}")
print(f"Кількість кроків траєкторії: {len(path)}")


# --- Приклад для Системи Рівнянь (Пункт 4) ---
# Наприклад: f1 = x1 + x2 - 3 = 0; f2 = x1^2 + x2^2 - 9 = 0
def system_target_function(X):
    f1 = X[0] + X[1] - 3
    f2 = X[0] ** 2 + X[1] ** 2 - 9
    return f1 ** 2 + f2 ** 2  # Побудова цільової функції Ф(X)
